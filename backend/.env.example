# Copy to .env and fill in. The .env file is git-ignored.

NODE_ENV=development
PORT=4000

# Local mongod or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cashback

# Base currency for all stored balances/aggregates
BASE_CURRENCY=USD

# Comma-separated origin(s) allowed by CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
